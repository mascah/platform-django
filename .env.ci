# CI environment variables
# This file is used by GitHub Actions for linting and testing
CELERY_BEAT_SCHEDULES_ENABLED=false

# No DATABASE_URL: CI exercises composition from the primitives below.
# PostgreSQL service container config
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=platform_django
POSTGRES_USER=platform_django
POSTGRES_PASSWORD=postgres

# Django
DJANGO_SECRET_KEY=test-secret-key-for-ci-only
DJANGO_VITE_DEV_MODE=False
DJANGO_ADMIN_URL=admin/

# Redis/Celery — no REDIS_URL either, so composition is exercised here too.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_FLOWER_USER=admin
CELERY_FLOWER_PASSWORD=admin

# Project identity — names the cache prefix and task queue.
PROJECT_SLUG=platform_django

# Sentry — a fake browser DSN, read at build time by Vite and at test time by
# the Playwright spec that asserts an uncaught React error reaches the host in
# it. Nothing leaves the runner: the spec fulfills the request itself. The
# environment is deliberately neither production nor a Preview, so the tag on
# the event is checkable.
VITE_SENTRY_DSN=https://e2epublickey@o0.ingest.us.sentry.io/0
VITE_SENTRY_ENVIRONMENT=e2e
