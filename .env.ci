# CI environment variables
# This file is used by GitHub Actions for linting and testing
CELERY_BEAT_SCHEDULES_ENABLED=false

# No DATABASE_URL: CI exercises composition from the primitives below.
# PostgreSQL service container config
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=platform_django
POSTGRES_USER=platform_django
POSTGRES_PASSWORD=postgres

# Django
USE_DOCKER=no
DJANGO_SECRET_KEY=test-secret-key-for-ci-only
DJANGO_VITE_DEV_MODE=False
DJANGO_ADMIN_URL=admin/

# Redis/Celery — no REDIS_URL either, so composition is exercised here too.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_FLOWER_USER=admin
CELERY_FLOWER_PASSWORD=admin
