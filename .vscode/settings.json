{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.semanticHighlighting.enabled": true,

  "tailwindCSS.experimental.configFile": "packages/ui/src/styles/globals.css",

  "files.eol": "\n",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "never"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript][javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json][jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html][django-html][jinja][jinja-html]": {
    "editor.defaultFormatter": "monosans.djlint",
    "djlint.enableLinting": true
  },
  "djlint.enableLinting": false,
  "python.languageServer": "Pylance",
  "python.testing.pytestEnabled": true,
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.extraPaths": ["./libs/*"],
  "mypy-type-checker.preferDaemon": true,
  "mypy-type-checker.reportingScope": "workspace",
  "[python]": {
    "editor.rulers": [89],
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.fixAll.pylance": "always",
      "source.unusedImports": "always",
      "source.convertImportFormat": "always"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },

  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.workingDirectories": ["./apps/platform_django"],

  "prettier.requireConfig": true
}
