# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env or run: bin/env-refresh
#
# All values have sensible defaults for local development.
# Override as needed for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Django composes DATABASE_URL from these; set DATABASE_URL to override.
# Host-shaped: containers override POSTGRES_HOST via docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=platform_django
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# The django-insecure- prefix triggers a warning if used in production.
DJANGO_SECRET_KEY=django-insecure-local-dev-key-do-not-use-in-production

# Django internals (leave as-is for local dev)
IPYTHONDIR=/app/.ipython
USE_DOCKER=yes
DJANGO_ADMIN_URL=admin/

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
# Redis is used for both Django cache and Celery broker + result backend.
# Django composes REDIS_URL from these; set REDIS_URL to override.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_FLOWER_USER=admin
CELERY_FLOWER_PASSWORD=admin

# -----------------------------------------------------------------------------
# Port Isolation
# -----------------------------------------------------------------------------
# Offset applied to ALL service ports for multi-project isolation.
# Each project needs a unique value (use increments of 20: 0, 20, 40, 60).
# Set automatically by bin/rename-project based on project name.
PROJECT_PORT_OFFSET=0

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
