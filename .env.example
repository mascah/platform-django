# =============================================================================
# Environment Configuration
# =============================================================================
# The template for .env — the one generated environment file. Run
# bin/env-refresh to create or update it; values you have edited by hand are
# preserved, and keys added here later are merged in.
#
# One Postgres and one Redis serve every worktree on this machine, so a
# worktree isolates by database name and Redis index rather than by running a
# stack of its own. Those two values and the two application ports are computed
# by bin/env-refresh when it first writes .env, and .env is the record of what
# it chose — there is no registry.
# =============================================================================

# -----------------------------------------------------------------------------
# Project identity
# -----------------------------------------------------------------------------
# Names this project's resources: its database, its cache keys, its task queue.
# Defaults to the checkout's own directory name, because the backing services
# are shared across every project on this machine and not just every worktree —
# a second copy of the template keeping this one's slug would land on its
# database. Set it explicitly to name the project something else.
PROJECT_SLUG=platform_django

# -----------------------------------------------------------------------------
# Application ports
# -----------------------------------------------------------------------------
# Django and Vite are application processes and run on the host, so these are
# the only ports that need allocating. bin/env-refresh assigns a free pair.
DJANGO_PORT=8000
VITE_PORT=5173

# -----------------------------------------------------------------------------
# PostgreSQL — one instance per machine, shared by every worktree
# -----------------------------------------------------------------------------
# Django composes DATABASE_URL from these; set DATABASE_URL to override.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=platform_django
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# The django-insecure- prefix triggers a warning if used in production.
DJANGO_SECRET_KEY=django-insecure-local-dev-key-do-not-use-in-production

IPYTHONDIR=.ipython
DJANGO_ADMIN_URL=admin/

# -----------------------------------------------------------------------------
# Redis / Celery — one instance per machine; worktrees isolate by index
# -----------------------------------------------------------------------------
# Redis backs both the Django cache and the Celery broker + result backend.
# Django composes REDIS_URL from these; set REDIS_URL to override. Clearing
# REDIS_HOST degrades to an in-process cache and inline task dispatch.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_FLOWER_USER=admin
CELERY_FLOWER_PASSWORD=admin
