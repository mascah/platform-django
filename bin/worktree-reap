#!/usr/bin/env bash
# =============================================================================
# bin/worktree-reap — remove the worktrees that are already finished
# =============================================================================
# A worktree holds one of the sixteen indices one Redis serves, and nothing
# reclaims it: a session that ends without the keep-or-remove prompt — a
# background job, a crash — leaves its worktree behind indefinitely. Sixteen
# goes quickly that way, and bin/worktree-create then fails with no index free.
#
#   bin/worktree-reap          list what would be removed
#   bin/worktree-reap --yes    remove it
#
# Finished means both halves: the branch is an ancestor of main, so every commit
# on it is already there, and the tree is clean, so nothing is uncommitted. A
# worktree on a detached HEAD is left alone — nothing put it there by accident.
#
# bin/worktree-create runs this before allocating, so the usual case needs
# nobody to remember it.
# =============================================================================
set -euo pipefail

log() { echo "$@" >&2; }

MAIN=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p' || true)
if [[ -z "$MAIN" ]]; then
  log "Error: $PWD is not a git checkout"
  exit 1
fi

# tail -n +2 drops the main checkout, which is never a candidate.
git -C "$MAIN" worktree list --porcelain | sed -n 's/^worktree //p' | tail -n +2 |
  while read -r path; do
    branch=$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null) || continue
    if [[ "$branch" == "HEAD" ]]; then continue; fi

    # The worktree this was invoked from is finished by the same test as often
    # as not, and reaping it would delete the caller out from under itself —
    # bin/worktree-create runs from the worktree the new one is branching off.
    if [[ "$path" -ef "$PWD" ]]; then continue; fi

    git -C "$MAIN" merge-base --is-ancestor "$branch" main 2>/dev/null || continue
    [[ -z "$(git -C "$path" status --porcelain 2>/dev/null)" ]] || continue

    if [[ "${1:-}" == "--yes" ]]; then
      "$MAIN/bin/worktree-destroy" "$path"
    else
      echo "would remove: $path"
    fi
  done
