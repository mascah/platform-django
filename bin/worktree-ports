#!/usr/bin/env zsh

# Port registry management utility for worktrees
# Usage: bin/worktree-ports [list|cleanup|status]

# Project-specific port configuration (change per-project to avoid conflicts)
PROJECT_NAME="platform-django"
REGISTRY_FILE="${HOME}/.${PROJECT_NAME}-worktree-ports.json"
PORT_POOL_START=8001  # Change to 8021, 8041, etc. for other projects
PORT_POOL_SIZE=10
PORT_POOL_END=$((PORT_POOL_START + PORT_POOL_SIZE))
BASE_PORT=8000

# Check for jq dependency
if ! command -v jq &>/dev/null; then
  echo "Error: jq is required but not installed"
  echo "Install with: brew install jq (macOS) or apt install jq (Linux)"
  exit 1
fi

# Initialize registry if it doesn't exist
init_registry() {
  if [[ ! -f "${REGISTRY_FILE}" ]]; then
    echo '{"allocations": {}, "version": 1}' > "${REGISTRY_FILE}"
  fi
}

# Check if a worktree path still exists and is valid
is_worktree_valid() {
  local path="$1"
  [[ -d "$path" ]] && git -C "$path" rev-parse --is-inside-work-tree &>/dev/null
}

cmd_list() {
  init_registry

  echo "Port Allocations (pool: ${PORT_POOL_START}-${PORT_POOL_END})"
  echo "==================================="

  local count=$(jq '.allocations | length' "${REGISTRY_FILE}" 2>/dev/null)
  if [[ "$count" == "0" || -z "$count" ]]; then
    echo "  No ports allocated"
  else
    # Show all service ports for each allocation
    jq -r --argjson base "$BASE_PORT" '.allocations | to_entries | sort_by(.key | tonumber) | .[] |
      "  \(.value.branch) (offset \(.key | tonumber - $base))\n    Django: \(.key)  Vite: \(.key | tonumber - $base + 5173)\n    Docker host ports: Postgres: \(.key | tonumber - $base + 5432)  Redis: \(.key | tonumber - $base + 6379)\n                       Mailpit: \(.key | tonumber - $base + 8025)  Flower: \(.key | tonumber - $base + 5555)\n    Path: \(.value.worktree_path)"' \
      "${REGISTRY_FILE}"
  fi

  echo ""
  echo "Status: ${count:-0}/${PORT_POOL_SIZE} ports allocated"
}

cmd_cleanup() {
  init_registry

  echo "Checking for stale entries..."
  echo ""

  local stale_count=0
  local temp_file=$(mktemp)

  # Find and report stale entries
  while IFS= read -r line; do
    local port=$(echo "$line" | cut -d' ' -f1)
    local path=$(echo "$line" | cut -d' ' -f2-)

    if ! is_worktree_valid "$path"; then
      echo "  Stale: port ${port} -> ${path}"
      ((stale_count++))
    fi
  done < <(jq -r '.allocations | to_entries[] | "\(.key) \(.value.worktree_path)"' "${REGISTRY_FILE}" 2>/dev/null)

  if [[ $stale_count -eq 0 ]]; then
    echo "  No stale entries found"
    return 0
  fi

  echo ""
  echo "Found ${stale_count} stale entries. Removing..."

  # Remove all stale entries
  cp "${REGISTRY_FILE}" "${temp_file}"
  while IFS= read -r line; do
    local port=$(echo "$line" | cut -d' ' -f1)
    local path=$(echo "$line" | cut -d' ' -f2-)

    if ! is_worktree_valid "$path"; then
      jq "del(.allocations[\"$port\"])" "${temp_file}" > "${temp_file}.new" && mv "${temp_file}.new" "${temp_file}"
    fi
  done < <(jq -r '.allocations | to_entries[] | "\(.key) \(.value.worktree_path)"' "${REGISTRY_FILE}" 2>/dev/null)

  mv "${temp_file}" "${REGISTRY_FILE}"
  echo "Cleanup complete. Freed ${stale_count} ports."
}

cmd_status() {
  init_registry

  echo "Registry: ${REGISTRY_FILE}"

  if [[ -f "${REGISTRY_FILE}" ]]; then
    local used=$(jq '.allocations | length' "${REGISTRY_FILE}" 2>/dev/null)
    local available=$((PORT_POOL_SIZE - used))
    echo "Allocated: ${used}/${PORT_POOL_SIZE}"
    echo "Available: ${available}"

    if [[ $available -eq 0 ]]; then
      echo ""
      echo "Warning: All ports are allocated!"
      echo "Run 'bin/worktree-ports cleanup' to free stale entries"
    fi
  else
    echo "Registry not initialized (will be created on first worktree)"
  fi
}

cmd_help() {
  echo "Worktree Port Registry Manager"
  echo ""
  echo "Usage: bin/worktree-ports [command]"
  echo ""
  echo "Commands:"
  echo "  list     Show all port allocations (default)"
  echo "  cleanup  Remove stale entries (deleted worktrees)"
  echo "  status   Show registry status summary"
  echo "  help     Show this help message"
  echo ""
  echo "Registry: ${REGISTRY_FILE}"
  echo ""
  echo "Port pools (${PORT_POOL_SIZE} slots, offset 1-${PORT_POOL_SIZE}):"
  echo "  Docker host ports (for external access to containers):"
  echo "    Django (DOCKER_HOST_DJANGO_PORT):             ${PORT_POOL_START}-${PORT_POOL_END} (${BASE_PORT} reserved for main)"
  echo "    Postgres (DOCKER_HOST_POSTGRES_PORT):         $((5432 + 1))-$((5432 + PORT_POOL_SIZE))"
  echo "    Redis (DOCKER_HOST_REDIS_PORT):               $((6379 + 1))-$((6379 + PORT_POOL_SIZE))"
  echo "    Mailpit (DOCKER_HOST_MAILPIT_PORT):           $((8025 + 1))-$((8025 + PORT_POOL_SIZE))"
  echo "    Flower (DOCKER_HOST_FLOWER_PORT):             $((5555 + 1))-$((5555 + PORT_POOL_SIZE))"
  echo "  App ports (runs on host):"
  echo "    Vite (VITE_PLATFORM_DJANGO_PORT):             $((5173 + 1))-$((5173 + PORT_POOL_SIZE))"
}

# Main
case "${1:-list}" in
  list)
    cmd_list
    ;;
  cleanup)
    cmd_cleanup
    ;;
  status)
    cmd_status
    ;;
  help|--help|-h)
    cmd_help
    ;;
  *)
    echo "Unknown command: $1"
    echo "Run 'bin/worktree-ports help' for usage"
    exit 1
    ;;
esac
