#!/usr/bin/env bash
# =============================================================================
# bin/worktree-destroy — Claude Code WorktreeRemove hook
# =============================================================================
# Called automatically when exiting a Claude Code worktree session.
# Stops Docker containers, releases port allocation, and removes the worktree.
#
# Contract:
#   stdin:  JSON with { worktree_path, session_id, hook_event_name }
#   stdout: Nothing required
#   stderr: All logging output
# =============================================================================
set -euo pipefail

# ---------------------------------------------------------------------------
# All output goes to stderr
# ---------------------------------------------------------------------------
log() { echo "$@" >&2; }

# ---------------------------------------------------------------------------
# Parse JSON input from stdin
# ---------------------------------------------------------------------------
INPUT=$(cat)
WORKTREE_PATH=$(echo "$INPUT" | jq -r '.worktree_path')

if [[ -z "$WORKTREE_PATH" || "$WORKTREE_PATH" == "null" ]]; then
  log "Error: 'worktree_path' field missing from input"
  exit 1
fi

log "Removing worktree: $WORKTREE_PATH"

# ---------------------------------------------------------------------------
# Find main worktree and registry
# ---------------------------------------------------------------------------
MAIN_WORKTREE=$(git -C "$WORKTREE_PATH" worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //' || true)

if [[ -z "$MAIN_WORKTREE" ]]; then
  log "Warning: Could not determine main worktree"
  MAIN_WORKTREE=$(dirname "$(dirname "$(dirname "$WORKTREE_PATH")")")
fi

REGISTRY_FILE="$MAIN_WORKTREE/.worktree-ports.json"

# ---------------------------------------------------------------------------
# Stop Docker containers (best-effort)
# ---------------------------------------------------------------------------
if [[ -d "$WORKTREE_PATH" && -f "$WORKTREE_PATH/docker-compose.yml" ]]; then
  log "Stopping Docker containers..."
  if [[ -f "$WORKTREE_PATH/.env.local" ]]; then
    (cd "$WORKTREE_PATH" && docker compose --env-file .env.local down 2>&1) >&2 || {
      log "Warning: Could not stop Docker containers (may not be running)"
    }
  fi
fi

# ---------------------------------------------------------------------------
# Release port allocation from registry
# ---------------------------------------------------------------------------
if [[ -f "$REGISTRY_FILE" ]] && command -v jq &>/dev/null; then
  FREED_PORT=$(jq -r --arg path "$WORKTREE_PATH" \
    '.allocations | to_entries[] | select(.value.worktree_path == $path) | .key' \
    "$REGISTRY_FILE" 2>/dev/null || true)

  if [[ -n "$FREED_PORT" ]]; then
    jq --arg path "$WORKTREE_PATH" \
       '.allocations |= with_entries(select(.value.worktree_path != $path))' \
       "$REGISTRY_FILE" > "$REGISTRY_FILE.tmp" && mv "$REGISTRY_FILE.tmp" "$REGISTRY_FILE"
    log "Released port $FREED_PORT"
  else
    log "No port allocation found for this worktree"
  fi
fi

# ---------------------------------------------------------------------------
# Extract branch name from worktree path
# ---------------------------------------------------------------------------
WORKTREE_NAME=$(basename "$WORKTREE_PATH")
BRANCH_NAME="worktree-$WORKTREE_NAME"

# ---------------------------------------------------------------------------
# Remove git worktree
# ---------------------------------------------------------------------------
if [[ -d "$WORKTREE_PATH" ]]; then
  log "Removing git worktree..."
  git -C "$MAIN_WORKTREE" worktree remove "$WORKTREE_PATH" --force 2>&1 >&2 || {
    log "Warning: git worktree remove failed, cleaning up manually"
    rm -rf "$WORKTREE_PATH"
    git -C "$MAIN_WORKTREE" worktree prune 2>&1 >&2 || true
  }
fi

# ---------------------------------------------------------------------------
# Delete the branch
# ---------------------------------------------------------------------------
if git -C "$MAIN_WORKTREE" show-ref --verify --quiet "refs/heads/$BRANCH_NAME" 2>/dev/null; then
  log "Deleting branch: $BRANCH_NAME"
  git -C "$MAIN_WORKTREE" branch -D "$BRANCH_NAME" 2>&1 >&2 || {
    log "Warning: Could not delete branch $BRANCH_NAME"
  }
fi

log "Worktree cleanup complete"
