#!/usr/bin/env bash
# =============================================================================
# bin/worktree-create — Claude Code WorktreeCreate hook
# =============================================================================
# Called automatically when `claude --worktree <name>` is invoked.
#
# A worktree needs no stack of its own: one Postgres and one Redis serve the
# machine, and the worktree isolates by database name and Redis index. Only the
# two application processes need a port. bin/env-refresh works all of that out
# and writes it into the worktree's .env, which is the record of what it took —
# there is no registry.
#
# Contract:
#   stdin:  JSON with { name, cwd, session_id, hook_event_name }
#   stdout: ONLY the absolute path to the created worktree
#   stderr: All logging/progress output
# =============================================================================
set -euo pipefail

# All logging goes to stderr (stdout is reserved for the worktree path).
log() { echo "$@" >&2; }

# ---------------------------------------------------------------------------
# Parse JSON input from stdin
# ---------------------------------------------------------------------------
INPUT=$(cat)
NAME=$(echo "$INPUT" | jq -r '.name')
CWD=$(echo "$INPUT" | jq -r '.cwd')

if [[ -z "$NAME" || "$NAME" == "null" ]]; then
  log "Error: 'name' field missing from input"
  exit 1
fi

if [[ -z "$CWD" || "$CWD" == "null" ]]; then
  log "Error: 'cwd' field missing from input"
  exit 1
fi

WORKTREE_DIR="$CWD/.claude/worktrees/$NAME"
BRANCH_NAME="worktree-$NAME"

# ---------------------------------------------------------------------------
# Create the git worktree
# ---------------------------------------------------------------------------
mkdir -p "$CWD/.claude/worktrees"

if git -C "$CWD" show-ref --verify --quiet "refs/heads/$BRANCH_NAME" 2>/dev/null; then
  git -C "$CWD" worktree add "$WORKTREE_DIR" "$BRANCH_NAME" >/dev/null 2>&1
  log "Checked out existing branch: $BRANCH_NAME"
else
  git -C "$CWD" worktree add -b "$BRANCH_NAME" "$WORKTREE_DIR" >/dev/null 2>&1
  log "Created new branch: $BRANCH_NAME"
fi

WORKTREE_ABS_PATH="$(cd "$WORKTREE_DIR" && pwd)"

# ---------------------------------------------------------------------------
# Environment file
# ---------------------------------------------------------------------------
# Seed from the parent checkout so hand-edited values — API keys, a real secret
# key — carry over, then --reallocate takes a fresh database, Redis index and
# port pair rather than inheriting the parent's and colliding with it.
log "Setting up .env..."

for file in ".env" ".npmrc"; do
  if [[ -f "$CWD/$file" ]]; then
    cp "$CWD/$file" "$WORKTREE_DIR/$file"
  fi
done

("$WORKTREE_DIR/bin/env-refresh" --reallocate) >&2

# ---------------------------------------------------------------------------
# Install dependencies
# ---------------------------------------------------------------------------
log "Installing dependencies..."
(cd "$WORKTREE_DIR" && uv sync 2>&1 && pnpm install 2>&1) >&2 || {
  log "Warning: Dependency install had issues (continuing)"
}

log ""
log "Worktree ready: $NAME"
(cd "$WORKTREE_DIR" && just ports) >&2 || true
log ""

# ---------------------------------------------------------------------------
# Output ONLY the worktree path (Claude Code reads this)
# ---------------------------------------------------------------------------
echo "$WORKTREE_ABS_PATH"
