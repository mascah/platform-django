#!/usr/bin/env zsh

# Git worktree creation and setup script
# Usage: . bin/worktree-new <branch-name>
# or: source bin/worktree-new <branch-name>

# Check for jq dependency
if ! command -v jq &>/dev/null; then
  echo "Error: jq is required but not installed"
  echo "Install with: brew install jq (macOS) or apt install jq (Linux)"
  return 1
fi

# Validate argument
if [[ -z "$1" ]]; then
  echo "Error: Branch name required"
  echo "Usage: . bin/worktree-new <branch-name>"
  return 1
fi

# --- Project-specific port configuration (change per-project to avoid conflicts) ---
PROJECT_NAME="platform-django"
REGISTRY_FILE="${HOME}/.${PROJECT_NAME}-worktree-ports.json"
PORT_POOL_START=8001  # Change to 8021, 8041, etc. for other projects
PORT_POOL_END=$((PORT_POOL_START + 10))
BASE_PORT=8000

# --- Port Registry Functions ---

# Initialize registry if it doesn't exist
init_registry() {
  if [[ ! -f "${REGISTRY_FILE}" ]]; then
    echo '{"allocations": {}, "version": 1}' > "${REGISTRY_FILE}"
  fi
}

# Check if a worktree path still exists and is valid
is_worktree_valid() {
  local path="$1"
  [[ -d "$path" ]] && git -C "$path" rev-parse --is-inside-work-tree &>/dev/null
}

# Clean stale entries from registry (worktrees that no longer exist)
clean_stale_entries() {
  local temp_file=$(mktemp)
  local stale_ports=()

  # Find stale entries
  while IFS= read -r line; do
    local port=$(echo "$line" | cut -d' ' -f1)
    local path=$(echo "$line" | cut -d' ' -f2-)
    if ! is_worktree_valid "$path"; then
      stale_ports+=("$port")
      echo "  Removing stale: port ${port} -> ${path}"
    fi
  done < <(jq -r '.allocations | to_entries[] | "\(.key) \(.value.worktree_path)"' "${REGISTRY_FILE}" 2>/dev/null)

  # Remove stale entries
  for port in "${stale_ports[@]}"; do
    jq "del(.allocations[\"$port\"])" "${REGISTRY_FILE}" > "${temp_file}" && mv "${temp_file}" "${REGISTRY_FILE}"
  done
}

# Find lowest available port in the pool
find_available_port() {
  init_registry

  for port in $(seq ${PORT_POOL_START} ${PORT_POOL_END}); do
    local allocation=$(jq -r ".allocations[\"$port\"]" "${REGISTRY_FILE}" 2>/dev/null)
    if [[ "$allocation" == "null" || -z "$allocation" ]]; then
      echo "$port"
      return 0
    fi
  done

  # No port available - try cleaning stale entries
  echo "  All ports in use, checking for stale entries..." >&2
  clean_stale_entries

  # Try again after cleanup
  for port in $(seq ${PORT_POOL_START} ${PORT_POOL_END}); do
    local allocation=$(jq -r ".allocations[\"$port\"]" "${REGISTRY_FILE}" 2>/dev/null)
    if [[ "$allocation" == "null" || -z "$allocation" ]]; then
      echo "$port"
      return 0
    fi
  done

  return 1  # All ports exhausted
}

# Allocate a port for a worktree
allocate_port() {
  local worktree_path="$1"
  local branch="$2"
  local port="$3"

  jq --arg port "$port" \
     --arg path "$worktree_path" \
     --arg branch "$branch" \
     '.allocations[$port] = {"worktree_path": $path, "branch": $branch}' \
     "${REGISTRY_FILE}" > "${REGISTRY_FILE}.tmp" && mv "${REGISTRY_FILE}.tmp" "${REGISTRY_FILE}"
}
# --- End Port Registry Functions ---

BRANCH_NAME="$1"
CURRENT_DIR="$(pwd)"
CURRENT_DIR_NAME="$(basename "${CURRENT_DIR}")"
WORKTREE_DIR="../${CURRENT_DIR_NAME}--${BRANCH_NAME}"

echo "Creating git worktree for branch: ${BRANCH_NAME}"

# Check if branch exists (locally or remotely)
if git show-ref --verify --quiet "refs/heads/${BRANCH_NAME}" || \
   git show-ref --verify --quiet "refs/remotes/origin/${BRANCH_NAME}"; then
  # Branch exists, check it out
  echo "Checking out existing branch"
  if ! git worktree add "${WORKTREE_DIR}" "${BRANCH_NAME}"; then
    echo "Failed to create git worktree"
    return 1
  fi
else
  # Branch doesn't exist, create it
  echo "Creating new branch"
  if ! git worktree add -b "${BRANCH_NAME}" "${WORKTREE_DIR}"; then
    echo "Failed to create git worktree"
    return 1
  fi
fi

echo "Worktree created at ${WORKTREE_DIR}"

# Get absolute path for the worktree (needed for registry)
# Use realpath to avoid cd which can trigger direnv hooks in subshells
export WORKTREE_ABS_PATH="$(realpath "${WORKTREE_DIR}")"

# Allocate port from registry
DOCKER_HOST_DJANGO_PORT=$(find_available_port)
if [[ -z "${DOCKER_HOST_DJANGO_PORT}" ]]; then
  echo ""
  echo "Error: No available ports in pool (${PORT_POOL_START}-${PORT_POOL_END})"
  echo "Run 'bin/worktree-ports cleanup' to free stale allocations"
  echo "Or remove unused worktrees with 'bin/worktree-remove'"
  return 1
fi

# Calculate all service ports based on offset from Django port
# Export these so they survive direnv environment switches when we cd later
export PORT_OFFSET=$((DOCKER_HOST_DJANGO_PORT - BASE_PORT))
export DOCKER_HOST_DJANGO_PORT
export VITE_PLATFORM_DJANGO_PORT=$((5173 + PORT_OFFSET))

# Docker host port mappings (for external access to containers, not internal networking)
export DOCKER_HOST_POSTGRES_PORT=$((5432 + PORT_OFFSET))
export DOCKER_HOST_REDIS_PORT=$((6379 + PORT_OFFSET))
export DOCKER_HOST_MAILPIT_PORT=$((8025 + PORT_OFFSET))
export DOCKER_HOST_FLOWER_PORT=$((5555 + PORT_OFFSET))

# Create a sanitized worktree ID for docker compose (lowercase, alphanumeric + underscore)
WORKTREE_ID=$(echo "${BRANCH_NAME}" | tr '[:upper:]' '[:lower:]' | tr -c '[:alnum:]' '_' | sed 's/_*$//')

# Register the port allocation
allocate_port "${WORKTREE_ABS_PATH}" "${BRANCH_NAME}" "${DOCKER_HOST_DJANGO_PORT}"

echo ""
echo "Allocated ports (from registry pool, offset ${PORT_OFFSET}):"
echo "  Django:       ${DOCKER_HOST_DJANGO_PORT}"
echo "  Vite:         ${VITE_PLATFORM_DJANGO_PORT}"
echo "  Postgres:     ${DOCKER_HOST_POSTGRES_PORT}"
echo "  Redis:        ${DOCKER_HOST_REDIS_PORT}"
echo "  Mailpit:      ${DOCKER_HOST_MAILPIT_PORT}"
echo "  Flower:       ${DOCKER_HOST_FLOWER_PORT}"

# Copy .env and .npmrc from source worktree (env-refresh handles .envrc and .env.local)
echo ""
echo "Copying configuration files..."
for file in ".env" ".npmrc"; do
  if [[ -f "${CURRENT_DIR}/${file}" ]]; then
    cp "${CURRENT_DIR}/${file}" "${WORKTREE_DIR}/${file}"
    echo "  Copied ${file}"
  else
    echo "  Skipped ${file} (not found)"
  fi
done

# env-refresh handles: .env merge, .envrc from template, .env.local from registry
echo ""
echo "Setting up environment files..."
(cd "${WORKTREE_DIR}" && ./bin/env-refresh)

# Copy .claude/settings.local.json if it exists
if [[ -f "${CURRENT_DIR}/.claude/settings.local.json" ]]; then
  mkdir -p "${WORKTREE_DIR}/.claude"
  cp "${CURRENT_DIR}/.claude/settings.local.json" "${WORKTREE_DIR}/.claude/settings.local.json"
  echo "  Copied .claude/settings.local.json"
else
  echo "  Skipped .claude/settings.local.json (not found)"
fi

# Save port values before cd (direnv will clear our exported vars)
_SAVED_DOCKER_HOST_DJANGO_PORT="${DOCKER_HOST_DJANGO_PORT}"
_SAVED_VITE_PORT="${VITE_PLATFORM_DJANGO_PORT}"

# Change to new worktree directory
cd "${WORKTREE_DIR}" || {
  echo "Failed to cd to ${WORKTREE_DIR}"
  return 1
}

# Allow direnv if available
if command -v direnv &> /dev/null && [[ -f .envrc ]]; then
  direnv allow
fi

echo "Running pnpm install..."
if pnpm install && uv sync; then
  echo "Dependencies installed successfully"
else
  echo "pnpm/uv install had issues (but continuing)"
fi

echo ""
echo "=== Worktree Setup Complete ==="
echo "Directory: $(pwd)"
echo "Django:    http://localhost:${_SAVED_DOCKER_HOST_DJANGO_PORT}"
echo "Vite:      http://localhost:${_SAVED_VITE_PORT}"
echo ""
echo "Next steps:"
echo "  1. Start Docker stack: just up"
echo "  2. Start Vite: pnpm dev"
echo ""
echo "Ready to launch Claude Code with: claude"
