#!/usr/bin/env bash
# =============================================================================
# bin/setup — developer conveniences, on top of bin/bootstrap
# =============================================================================
# Everything the application needs to run lives in bin/bootstrap, which this
# delegates to first. What is left here is optional and personal: shell
# integration so commands work without a `mise exec` prefix, git hooks, and a
# couple of macOS extras.
#
# Idempotent — safe to run repeatedly.
#
# Usage: bin/setup
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

info()    { printf "\033[1;34m==>\033[0m %s\n" "$1"; }
success() { printf "\033[1;32m✓\033[0m %s\n" "$1"; }
warn()    { printf "\033[1;33m!\033[0m %s\n" "$1"; }

has_command() { command -v "$1" &>/dev/null; }

cd "$PROJECT_DIR"

# -----------------------------------------------------------------------------
# 1. Everything that actually makes the checkout runnable
# -----------------------------------------------------------------------------
"$SCRIPT_DIR/bootstrap"

MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"

echo ""
echo "============================================"
echo "  Developer conveniences"
echo "============================================"
echo ""

# -----------------------------------------------------------------------------
# 2. Command-line extras (macOS)
# -----------------------------------------------------------------------------
if has_command brew; then
  info "Checking command-line extras..."
  for pkg in gh jq; do
    if has_command "$pkg"; then
      success "$pkg already installed"
    else
      brew install "$pkg"
      success "$pkg installed"
    fi
  done
else
  warn "Homebrew not present — skipping gh and jq (both optional)"
fi

# -----------------------------------------------------------------------------
# 3. Shell integration
# -----------------------------------------------------------------------------
# Two shells to cover, and they read different files. A terminal gets `mise
# activate`, which swaps the toolchain per directory from a prompt hook. An
# agent harness runs its commands in a login shell that is not interactive: it
# reads the profile, never the rc file, and no prompt hook ever fires. That
# shell gets shims, which resolve without a hook and so work in exactly the
# case activation misses — otherwise an agent runs the machine's own node and
# lefthook rather than the versions this repo pins.
info "Checking shell integration..."

case "${SHELL:-}" in
  */bash) SHELL_NAME=bash; SHELL_RC="$HOME/.bashrc" ;;
  *)      SHELL_NAME=zsh;  SHELL_RC="$HOME/.zshrc" ;;
esac

if grep -q 'mise activate' "$SHELL_RC" 2>/dev/null; then
  success "mise already activated in $SHELL_RC"
else
  {
    echo ""
    echo "# Added by platform-django/bin/setup"
    echo "eval \"\$($MISE activate $SHELL_NAME)\""
  } >> "$SHELL_RC"
  success "mise activation added to $SHELL_RC"
  warn "Restart your terminal, or run: source $SHELL_RC"
fi

# Appending to a .bash_profile that does not exist would stop bash reading
# .profile at all, so prefer whichever the machine already has.
case "$SHELL_NAME" in
  bash)
    SHELL_PROFILE="$HOME/.bash_profile"
    [ -f "$SHELL_PROFILE" ] || SHELL_PROFILE="$HOME/.profile"
    ;;
  *) SHELL_PROFILE="$HOME/.zprofile" ;;
esac

if grep -q 'mise activate' "$SHELL_PROFILE" 2>/dev/null; then
  success "mise shims already on PATH in $SHELL_PROFILE"
else
  {
    echo ""
    echo "# Added by platform-django/bin/setup"
    echo "eval \"\$($MISE activate $SHELL_NAME --shims)\""
  } >> "$SHELL_PROFILE"
  success "mise shims added to $SHELL_PROFILE"
fi

# -----------------------------------------------------------------------------
# 4. Git hooks
# -----------------------------------------------------------------------------
info "Installing git hooks..."
"$MISE" exec -- lefthook install
success "Git hooks installed"

# -----------------------------------------------------------------------------
# 5. Agent harness mirrors
# -----------------------------------------------------------------------------
# Committed, so a clean checkout already has them. Run here anyway: it is what
# makes them correct after a merge that added a skill, and it costs nothing.
info "Syncing agent harness mirrors..."
"$SCRIPT_DIR/sync-agents" >/dev/null
success "Agent mirrors synced"

echo ""
success "Setup complete."
echo ""
