#!/usr/bin/env bash
# =============================================================================
# Developer Setup Script
# =============================================================================
# Idempotent setup script for new developers.
# Safe to run multiple times — only installs/configures what's missing.
#
# Usage: bin/setup
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# -----------------------------------------------------------------------------
# Output helpers
# -----------------------------------------------------------------------------
info()    { printf "\033[1;34m==>\033[0m %s\n" "$1"; }
success() { printf "\033[1;32m✓\033[0m %s\n" "$1"; }
warn()    { printf "\033[1;33m!\033[0m %s\n" "$1"; }
error()   { printf "\033[1;31m✗\033[0m %s\n" "$1"; }

# Check if command exists
has_command() { command -v "$1" &> /dev/null; }

# Get the command name for a package (most are the same, some differ)
pkg_command() {
  case "$1" in
    libpq) echo "pg_config" ;;
    *) echo "$1" ;;
  esac
}

cd "$PROJECT_DIR"

echo ""
echo "============================================"
echo "  Developer Setup"
echo "============================================"
echo ""

# -----------------------------------------------------------------------------
# 1. Homebrew check
# -----------------------------------------------------------------------------
info "Checking Homebrew..."
if ! has_command brew; then
  error "Homebrew is required but not installed."
  echo "  Install from https://brew.sh"
  exit 1
fi
success "Homebrew installed"

# -----------------------------------------------------------------------------
# 2. Tools via Homebrew
# -----------------------------------------------------------------------------
info "Checking tools..."

BREW_PACKAGES=(pyenv uv just lefthook direnv libpq gh jq)
for pkg in "${BREW_PACKAGES[@]}"; do
  cmd=$(pkg_command "$pkg")
  if has_command "$cmd"; then
    success "$pkg already installed"
  else
    info "Installing $pkg..."
    brew install "$pkg"
    success "$pkg installed"
  fi
done

# -----------------------------------------------------------------------------
# 3. Python setup via pyenv
# -----------------------------------------------------------------------------
info "Setting up Python..."

if [[ -f .python-version ]]; then
  PYTHON_VERSION=$(cat .python-version)

  if pyenv versions --bare 2>/dev/null | grep -q "^${PYTHON_VERSION}"; then
    success "Python $PYTHON_VERSION already installed"
  else
    info "Installing Python $PYTHON_VERSION via pyenv..."
    pyenv install "$PYTHON_VERSION"
    success "Python $PYTHON_VERSION installed"
  fi

  pyenv local "$PYTHON_VERSION"
  success "Python $PYTHON_VERSION configured"
else
  warn ".python-version file not found, skipping Python setup"
fi

# -----------------------------------------------------------------------------
# 4. Node.js setup via nvm
# -----------------------------------------------------------------------------
info "Setting up Node.js..."

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

# Install nvm if not present
if [[ ! -d "$NVM_DIR" ]]; then
  info "Installing nvm..."
  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.0/install.sh | bash
  success "nvm installed"
fi

# Source nvm for this session
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck source=/dev/null
  \. "$NVM_DIR/nvm.sh"
fi

if [[ -f .nvmrc ]]; then
  NODE_VERSION=$(cat .nvmrc)

  if nvm ls "$NODE_VERSION" &> /dev/null; then
    success "Node.js $NODE_VERSION already installed"
  else
    info "Installing Node.js $NODE_VERSION..."
    nvm install
    success "Node.js $NODE_VERSION installed"
  fi

  nvm use "$NODE_VERSION" > /dev/null

  # Enable corepack for pnpm
  if ! has_command pnpm; then
    info "Enabling pnpm via corepack..."
    corepack enable
    corepack prepare pnpm --activate
    success "pnpm enabled"
  else
    success "pnpm already available"
  fi

  success "Node.js $(node --version) and pnpm $(pnpm --version) configured"
else
  warn ".nvmrc file not found, skipping Node.js setup"
fi

# -----------------------------------------------------------------------------
# 5. Shell configuration
# -----------------------------------------------------------------------------
info "Checking shell configuration..."

# Detect shell config file
if [[ "$SHELL" == */zsh ]]; then
  SHELL_RC="$HOME/.zshrc"
  SHELL_NAME="zsh"
elif [[ "$SHELL" == */bash ]]; then
  SHELL_RC="$HOME/.bashrc"
  SHELL_NAME="bash"
else
  SHELL_RC="$HOME/.zshrc"
  SHELL_NAME="zsh"
fi

SHELL_CHANGED=false

# direnv hook
if ! grep -q 'direnv hook' "$SHELL_RC" 2>/dev/null; then
  info "Adding direnv hook to $SHELL_RC..."
  {
    echo ""
    echo "# Added by platform-django/bin/setup"
    echo "eval \"\$(direnv hook $SHELL_NAME)\""
  } >> "$SHELL_RC"
  SHELL_CHANGED=true
  success "direnv hook added"
else
  success "direnv hook already configured"
fi

# libpq PATH (for psycopg compilation)
# Check both Intel and Apple Silicon paths
if [[ -d "/opt/homebrew/opt/libpq/bin" ]]; then
  LIBPQ_PATH="/opt/homebrew/opt/libpq/bin"
elif [[ -d "/usr/local/opt/libpq/bin" ]]; then
  LIBPQ_PATH="/usr/local/opt/libpq/bin"
else
  LIBPQ_PATH=""
fi

if [[ -n "$LIBPQ_PATH" ]] && ! grep -q 'libpq/bin' "$SHELL_RC" 2>/dev/null; then
  info "Adding libpq to PATH in $SHELL_RC..."
  echo "export PATH=\"$LIBPQ_PATH:\$PATH\"" >> "$SHELL_RC"
  SHELL_CHANGED=true
  success "libpq PATH added"
else
  success "libpq PATH already configured (or not needed)"
fi

if [[ "$SHELL_CHANGED" == "true" ]]; then
  warn "Shell config changed - restart your terminal or run: source $SHELL_RC"
fi

# -----------------------------------------------------------------------------
# 6. Environment files (.env, .envrc)
# -----------------------------------------------------------------------------
info "Setting up environment files..."
"$SCRIPT_DIR/env-refresh"

# -----------------------------------------------------------------------------
# 7. Project dependencies
# -----------------------------------------------------------------------------
info "Installing project dependencies..."

# Python dependencies
info "Installing Python dependencies (uv sync)..."
if uv sync; then
  success "Python dependencies installed"
else
  warn "Python dependencies had issues (continuing)"
fi

# Frontend dependencies
info "Installing frontend dependencies (pnpm install)..."
if pnpm install; then
  success "Frontend dependencies installed"
else
  warn "Frontend dependencies had issues (continuing)"
fi

# -----------------------------------------------------------------------------
# 8. Git hooks
# -----------------------------------------------------------------------------
info "Setting up git hooks..."

if [[ -f .git/hooks/pre-commit ]] && grep -q 'lefthook' .git/hooks/pre-commit 2>/dev/null; then
  success "Git hooks already installed"
else
  if has_command lefthook; then
    lefthook install
    success "Git hooks installed"
  else
    warn "lefthook not available, skipping git hooks"
  fi
fi

# -----------------------------------------------------------------------------
# Done!
# -----------------------------------------------------------------------------
echo ""
echo "============================================"
echo "  Setup Complete!"
echo "============================================"
echo ""
echo "Verify your installation:"
echo "  python --version    # Should show Python $(cat .python-version 2>/dev/null || echo '3.13')"
echo "  node --version      # Should show $(cat .nvmrc 2>/dev/null || echo 'v24.x')"
echo "  pnpm --version      # Should show 11.x"
echo ""
echo "Next steps:"
echo "  1. Restart your terminal (to load shell config changes)"
echo "  2. Run: just up        # Start all services in docker"
echo "  3. Run: pnpm dev       # Start Vite dev server (new terminal)"
echo ""
echo "Access the app at http://localhost:8000"
echo ""
