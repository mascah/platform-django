#!/usr/bin/env bash
# =============================================================================
# bin/env-refresh — Refresh .env and .envrc from their .example templates
# =============================================================================
# Merges new variables from .env.example into .env without overwriting
# manually-set values. Backs up the previous .env before writing.
#
# Usage: bin/env-refresh [--force]
#   --force  Overwrite .env completely from .env.example (no merge)
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR"

# -----------------------------------------------------------------------------
# Project-specific port configuration (change per-project to avoid conflicts)
# -----------------------------------------------------------------------------
PROJECT_NAME="platform-django"
REGISTRY_FILE="${HOME}/.${PROJECT_NAME}-worktree-ports.json"
PORT_POOL_START=8001  # Change to 8021, 8041, etc. for other projects
BASE_PORT=8000

# -----------------------------------------------------------------------------
# Output helpers
# -----------------------------------------------------------------------------
info()    { printf "\033[1;34m==>\033[0m %s\n" "$1"; }
success() { printf "\033[1;32m✓\033[0m %s\n" "$1"; }
warn()    { printf "\033[1;33m!\033[0m %s\n" "$1"; }

# -----------------------------------------------------------------------------
# Parse arguments
# -----------------------------------------------------------------------------
FORCE=false
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
    -h|--help)
      echo "Usage: bin/env-refresh [--force]"
      echo ""
      echo "Refresh .env, .env.local and .envrc from their .example templates."
      echo ""
      echo "Options:"
      echo "  --force  Overwrite .env entirely from .env.example (no merge)"
      echo ""
      echo "Without --force, performs an additive merge:"
      echo "  - New variables from .env.example are added"
      echo "  - Existing values in .env are preserved"
      echo "  - Variables removed from .env.example are kept as orphans"
      exit 0
      ;;
    *)
      echo "Unknown argument: $arg"
      echo "Usage: bin/env-refresh [--force]"
      exit 1
      ;;
  esac
done

# -----------------------------------------------------------------------------
# Validate templates exist
# -----------------------------------------------------------------------------
if [[ ! -f .env.example ]]; then
  echo "Error: .env.example not found in $PROJECT_DIR"
  exit 1
fi

# -----------------------------------------------------------------------------
# Helper: extract KEY from a KEY=VALUE line
# -----------------------------------------------------------------------------
extract_key() {
  echo "$1" | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'
}

# Helper: get the value for a key from a file (first match)
get_value_from_file() {
  local key="$1"
  local file="$2"
  grep -m1 "^${key}=" "$file" 2>/dev/null | sed "s/^${key}=//"
}

# Helper: check if a key exists in a file
key_exists_in_file() {
  local key="$1"
  local file="$2"
  grep -q "^${key}=" "$file" 2>/dev/null
}

# -----------------------------------------------------------------------------
# Refresh .env
# -----------------------------------------------------------------------------
info "Refreshing .env from .env.example..."

if [[ ! -f .env ]]; then
  # No existing .env — simple copy
  cp .env.example .env
  success "Created .env from .env.example"
elif [[ "$FORCE" == "true" ]]; then
  # Force mode — backup and overwrite
  cp .env .env.backup
  cp .env.example .env
  success "Overwrote .env from .env.example (backup: .env.backup)"
else
  # Additive merge: walk .env.example, preserve existing values
  cp .env .env.backup

  TEMP_ENV=$(mktemp)
  SEEN_KEYS=$(mktemp)

  NEW_VARS=()
  PRESERVED_VARS=()

  # Process .env.example line by line
  while IFS= read -r line || [[ -n "$line" ]]; do
    key=$(extract_key "$line")

    if [[ -z "$key" ]]; then
      # Comment or blank line — pass through
      echo "$line" >> "$TEMP_ENV"
    else
      # Track this key as seen
      echo "$key" >> "$SEEN_KEYS"

      if key_exists_in_file "$key" .env; then
        old_value=$(get_value_from_file "$key" .env)

        if echo "$old_value" | grep -q '!!!SET'; then
          # Old value is still a placeholder — use template default
          echo "$line" >> "$TEMP_ENV"
          NEW_VARS+=("$key")
        else
          # Preserve existing value
          echo "${key}=${old_value}" >> "$TEMP_ENV"
          PRESERVED_VARS+=("$key")
        fi
      else
        # New variable — use template default
        echo "$line" >> "$TEMP_ENV"
        NEW_VARS+=("$key")
      fi
    fi
  done < .env.example

  # Find orphaned keys (in old .env but not in .env.example)
  ORPHAN_KEYS=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    key=$(extract_key "$line")
    if [[ -n "$key" ]] && ! grep -q "^${key}$" "$SEEN_KEYS"; then
      ORPHAN_KEYS+=("$key")
    fi
  done < .env

  # Append orphaned keys
  if [[ ${#ORPHAN_KEYS[@]} -gt 0 ]]; then
    echo "" >> "$TEMP_ENV"
    echo "# -----------------------------------------------------------------------------" >> "$TEMP_ENV"
    echo "# Custom overrides (not in .env.example)" >> "$TEMP_ENV"
    echo "# -----------------------------------------------------------------------------" >> "$TEMP_ENV"
    for orphan_key in "${ORPHAN_KEYS[@]}"; do
      orphan_value=$(get_value_from_file "$orphan_key" .env)
      echo "${orphan_key}=${orphan_value}" >> "$TEMP_ENV"
    done
  fi

  mv "$TEMP_ENV" .env
  rm -f "$SEEN_KEYS"

  # Print summary
  if [[ ${#NEW_VARS[@]} -gt 0 ]]; then
    success "Added ${#NEW_VARS[@]} new variable(s):"
    for var in "${NEW_VARS[@]}"; do
      echo "    + $var"
    done
  fi

  if [[ ${#PRESERVED_VARS[@]} -gt 0 ]]; then
    success "Preserved ${#PRESERVED_VARS[@]} existing value(s)"
  fi

  if [[ ${#ORPHAN_KEYS[@]} -gt 0 ]]; then
    warn "Carried forward ${#ORPHAN_KEYS[@]} orphaned variable(s) not in .env.example:"
    for var in "${ORPHAN_KEYS[@]}"; do
      echo "    ~ $var"
    done
  fi

  if [[ ${#NEW_VARS[@]} -eq 0 && ${#ORPHAN_KEYS[@]} -eq 0 ]]; then
    success ".env is up to date (backup: .env.backup)"
  else
    success ".env refreshed (backup: .env.backup)"
  fi
fi

# -----------------------------------------------------------------------------
# Refresh .envrc
# -----------------------------------------------------------------------------
if [[ -f .envrc.example ]]; then
  if [[ ! -f .envrc ]]; then
    cp .envrc.example .envrc
    success "Created .envrc from .envrc.example"
  elif ! diff -q .envrc .envrc.example &>/dev/null; then
    cp .envrc.example .envrc
    success "Updated .envrc from .envrc.example"
  else
    success ".envrc is up to date"
  fi
fi

# -----------------------------------------------------------------------------
# Ensure .env.local exists (port configuration)
# -----------------------------------------------------------------------------
if [[ -f .env.local ]]; then
  success ".env.local already exists"
else
  info "Creating .env.local..."

  CURRENT_PATH="$(pwd)"
  PORT_OFFSET=0
  WORKTREE_ID="main"
  BRANCH_NAME=""

  # Try to look up this directory in the worktree port registry
  if command -v jq &>/dev/null && [[ -f "$REGISTRY_FILE" ]]; then
    # Search registry for an entry matching our current path
    MATCH=$(jq -r --arg path "$CURRENT_PATH" '
      .allocations | to_entries[] |
      select(.value.worktree_path == $path) |
      "\(.key) \(.value.branch)"
    ' "$REGISTRY_FILE" 2>/dev/null || true)

    if [[ -n "$MATCH" ]]; then
      DJANGO_PORT=$(echo "$MATCH" | cut -d' ' -f1)
      BRANCH_NAME=$(echo "$MATCH" | cut -d' ' -f2-)
      PORT_OFFSET=$((DJANGO_PORT - BASE_PORT))
      WORKTREE_ID=$(echo "$BRANCH_NAME" | tr '[:upper:]' '[:lower:]' | tr -c '[:alnum:]' '_' | sed 's/_*$//')
      info "Found worktree in registry: branch=$BRANCH_NAME, port=$DJANGO_PORT (offset $PORT_OFFSET)"
    fi
  elif ! command -v jq &>/dev/null; then
    warn "jq not installed — using main branch defaults for .env.local"
  fi

  cat > .env.local << EOF
# Port configuration (auto-generated by bin/env-refresh)
# Worktree: ${BRANCH_NAME:-main branch}
# Port offset: ${PORT_OFFSET}

# Docker host port mappings (for external access to containers)
DOCKER_HOST_DJANGO_PORT=$((BASE_PORT + PORT_OFFSET))
DOCKER_HOST_POSTGRES_PORT=$((5432 + PORT_OFFSET))
DOCKER_HOST_REDIS_PORT=$((6379 + PORT_OFFSET))
DOCKER_HOST_MAILPIT_PORT=$((8025 + PORT_OFFSET))
DOCKER_HOST_FLOWER_PORT=$((5555 + PORT_OFFSET))

# App config (Vite runs on host)
VITE_PLATFORM_DJANGO_PORT=$((5173 + PORT_OFFSET))

# Docker container naming
WORKTREE_ID=${WORKTREE_ID}
EOF
  success "Created .env.local (offset $PORT_OFFSET, WORKTREE_ID=$WORKTREE_ID)"
fi

# -----------------------------------------------------------------------------
# Allow direnv
# -----------------------------------------------------------------------------
if command -v direnv &>/dev/null && [[ -f .envrc ]]; then
  direnv allow
  success "direnv allowed"
fi
