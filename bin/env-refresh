#!/usr/bin/env bash
# =============================================================================
# bin/env-refresh — generate .env, the one environment file
# =============================================================================
# Merges .env.example into .env: keys added to the template appear, values
# edited by hand are kept, so this is safe to run at any time.
#
# The values that must differ between worktrees sharing this machine's Postgres
# and Redis — the database name, the Redis index, and the two application ports
# — are computed on first write. .env is itself the record of what was
# allocated: siblings are read out of their own .env files, so there is no
# registry to go stale and nothing to clean up. Ports are additionally probed,
# because a sibling's .env only knows what this project handed out and the
# machine is shared with everything else running on it.
#
# Usage: bin/env-refresh [--force] [--reallocate]
#   --force       Discard existing values and regenerate from the template
#   --reallocate  Keep hand-edited values, but claim a fresh database, Redis
#                 index and port pair — what a new worktree needs after
#                 inheriting the .env it was copied from
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR"

info()    { printf "\033[1;34m==>\033[0m %s\n" "$1"; }
success() { printf "\033[1;32m✓\033[0m %s\n" "$1"; }
warn()    { printf "\033[1;33m!\033[0m %s\n" "$1"; }

# -----------------------------------------------------------------------------
# Parse arguments
# -----------------------------------------------------------------------------
FORCE=false
REALLOCATE=false
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
    --reallocate) REALLOCATE=true ;;
    -h|--help)
      echo "Usage: bin/env-refresh [--force] [--reallocate]"
      echo ""
      echo "Generate .env from .env.example."
      echo ""
      echo "Options:"
      echo "  --force       Discard existing values and regenerate from the template"
      echo "  --reallocate  Keep hand-edited values, but claim a fresh database,"
      echo "                Redis index and port pair"
      echo ""
      echo "By default:"
      echo "  - New variables from .env.example are added"
      echo "  - Existing values in .env are preserved"
      echo "  - Variables removed from .env.example are kept as orphans"
      exit 0
      ;;
    *)
      echo "Unknown argument: $arg"
      echo "Usage: bin/env-refresh [--force] [--reallocate]"
      exit 1
      ;;
  esac
done

if [[ ! -f .env.example ]]; then
  echo "Error: .env.example not found in $PROJECT_DIR"
  exit 1
fi

# -----------------------------------------------------------------------------
# Reading KEY=VALUE files
# -----------------------------------------------------------------------------
extract_key() {
  echo "$1" | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'
}

# An absent key — or an absent file — is a normal answer here, not a failure.
get_value_from_file() {
  local key="$1" file="$2"
  grep -m1 "^${key}=" "$file" 2>/dev/null | sed "s/^${key}=//" || return 0
}

key_exists_in_file() {
  local key="$1" file="$2"
  grep -q "^${key}=" "$file" 2>/dev/null
}

# Lowercase, with anything that cannot name a database turned into an underscore.
slugify() {
  basename "$1" | tr '[:upper:]' '[:lower:]' | tr -c '[:alnum:]' '_' | sed 's/_*$//'
}

# -----------------------------------------------------------------------------
# Which project, and which worktree of it?
# -----------------------------------------------------------------------------
# The main worktree is the first `git worktree list` reports. Tolerate git being
# unusable — bootstrap runs this on checkouts git will not touch (a container
# mount, an unpacked archive), which are the main worktree by default.
WORKTREE_NAME=""
MAIN_WORKTREE=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p' || true)
if [[ -n "$MAIN_WORKTREE" && ! "$PROJECT_DIR" -ef "$MAIN_WORKTREE" ]]; then
  WORKTREE_NAME=$(slugify "$PROJECT_DIR")
fi

# The slug names this project's resources. Backing services are shared across
# every project on the machine, not just every worktree, so a second copy of the
# template that kept the template's own slug would land on the first copy's
# database. Defaulting to the checkout's own directory name means copying the
# template is still a clone with nothing renamed, and two copies still differ.
PROJECT_SLUG=$(get_value_from_file PROJECT_SLUG .env)
COMPUTED_PROJECT_SLUG=${PROJECT_SLUG:-$(slugify "${MAIN_WORKTREE:-$PROJECT_DIR}")}
PROJECT_SLUG="$COMPUTED_PROJECT_SLUG"

# -----------------------------------------------------------------------------
# Allocation, with the sibling .env files as the record
# -----------------------------------------------------------------------------
# Values every other worktree of this repository currently claims for $1.
values_claimed_by_siblings() {
  local key="$1" path
  while read -r path; do
    if [[ -f "$path/.env" ]] && [[ ! "$path" -ef "$PROJECT_DIR" ]]; then
      get_value_from_file "$key" "$path/.env"
    fi
  done < <(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
}

# Whether anything on this machine is listening on port $1. bash's own /dev/tcp
# rather than lsof or nc, neither of which is installed everywhere this runs.
port_is_free() {
  ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# The lowest value at or above $2 that no sibling claims for key $1. Passing a
# third argument also probes the candidate: a sibling's .env says a port is
# spoken for before anything listens on it, and a bound port says so even when
# no sibling of ours claims it — another project, or something unrelated.
allocate() {
  local key="$1" candidate="$2" probe="${3:-}" claimed
  claimed=$(values_claimed_by_siblings "$key")
  while grep -qxF "$candidate" <<<"$claimed" ||
    { [[ -n "$probe" ]] && ! port_is_free "$candidate"; }; do
    candidate=$((candidate + 1))
  done
  echo "$candidate"
}

# The slug names the database; a worktree gets its own beside it. Postgres
# truncates identifiers at 63 bytes, which would silently alias two long
# worktree names onto one database.
COMPUTED_POSTGRES_DB="${PROJECT_SLUG}${WORKTREE_NAME:+_$WORKTREE_NAME}"
COMPUTED_POSTGRES_DB="${COMPUTED_POSTGRES_DB:0:63}"

COMPUTED_REDIS_DB=$(allocate REDIS_DB 0)
if [[ "$COMPUTED_REDIS_DB" -gt 15 ]]; then
  echo "Error: no free Redis index — one Redis serves 16, and all are claimed."
  exit 1
fi

COMPUTED_DJANGO_PORT=$(allocate DJANGO_PORT 8000 probe)
COMPUTED_VITE_PORT=$(allocate VITE_PORT 5173 probe)

# Used in place of the template default when a key is written for the first
# time. An existing value always wins, so re-running never moves a worktree.
computed_value() {
  case "$1" in
    PROJECT_SLUG) echo "$COMPUTED_PROJECT_SLUG" ;;
    POSTGRES_DB)  echo "$COMPUTED_POSTGRES_DB" ;;
    REDIS_DB)     echo "$COMPUTED_REDIS_DB" ;;
    DJANGO_PORT)  echo "$COMPUTED_DJANGO_PORT" ;;
    VITE_PORT)    echo "$COMPUTED_VITE_PORT" ;;
  esac
}

# -----------------------------------------------------------------------------
# Merge
# -----------------------------------------------------------------------------
info "Refreshing .env from .env.example..."

if [[ -f .env ]]; then
  cp .env .env.backup
  if [[ "$FORCE" == "true" ]]; then
    : > .env
  fi
else
  : > .env
fi

TEMP_ENV=$(mktemp)
SEEN_KEYS=$(mktemp)

NEW_VARS=()
PRESERVED_VARS=()

while IFS= read -r line || [[ -n "$line" ]]; do
  key=$(extract_key "$line")

  if [[ -z "$key" ]]; then
    # Comment or blank line — pass through
    echo "$line" >> "$TEMP_ENV"
    continue
  fi

  echo "$key" >> "$SEEN_KEYS"
  old_value=$(get_value_from_file "$key" .env)
  computed=$(computed_value "$key")

  keep_existing=true
  if ! key_exists_in_file "$key" .env; then
    keep_existing=false
  elif grep -q '!!!SET' <<<"$old_value"; then
    # Still the template's placeholder rather than a real value.
    keep_existing=false
  elif [[ "$REALLOCATE" == "true" && -n "$computed" ]]; then
    keep_existing=false
  fi

  if [[ "$keep_existing" == "true" ]]; then
    echo "${key}=${old_value}" >> "$TEMP_ENV"
    PRESERVED_VARS+=("$key")
  elif [[ -n "$computed" ]]; then
    echo "${key}=${computed}" >> "$TEMP_ENV"
    NEW_VARS+=("$key")
  else
    echo "$line" >> "$TEMP_ENV"
    NEW_VARS+=("$key")
  fi
done < .env.example

# Keys in .env that the template no longer carries
ORPHAN_KEYS=()
while IFS= read -r line || [[ -n "$line" ]]; do
  key=$(extract_key "$line")
  if [[ -n "$key" ]] && ! grep -q "^${key}$" "$SEEN_KEYS"; then
    ORPHAN_KEYS+=("$key")
  fi
done < .env

if [[ ${#ORPHAN_KEYS[@]} -gt 0 ]]; then
  {
    echo ""
    echo "# -----------------------------------------------------------------------------"
    echo "# Custom overrides (not in .env.example)"
    echo "# -----------------------------------------------------------------------------"
  } >> "$TEMP_ENV"
  for orphan_key in "${ORPHAN_KEYS[@]}"; do
    echo "${orphan_key}=$(get_value_from_file "$orphan_key" .env)" >> "$TEMP_ENV"
  done
fi

mv "$TEMP_ENV" .env
rm -f "$SEEN_KEYS"

# -----------------------------------------------------------------------------
# Summary
# -----------------------------------------------------------------------------
if [[ ${#NEW_VARS[@]} -gt 0 ]]; then
  success "Set ${#NEW_VARS[@]} variable(s):"
  for var in "${NEW_VARS[@]}"; do
    echo "    + ${var}=$(get_value_from_file "$var" .env)"
  done
fi

if [[ ${#PRESERVED_VARS[@]} -gt 0 ]]; then
  success "Preserved ${#PRESERVED_VARS[@]} existing value(s)"
fi

if [[ ${#ORPHAN_KEYS[@]} -gt 0 ]]; then
  warn "Carried forward ${#ORPHAN_KEYS[@]} variable(s) not in .env.example:"
  for var in "${ORPHAN_KEYS[@]}"; do
    echo "    ~ $var"
  done
fi

success ".env ready for ${WORKTREE_NAME:-the main worktree}: database $(get_value_from_file POSTGRES_DB .env), Django on port $(get_value_from_file DJANGO_PORT .env)"
