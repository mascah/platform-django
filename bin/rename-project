#!/usr/bin/env bash
# =============================================================================
# Project Rename Script
# =============================================================================
# Renames platform_django / platform-django / Platform Django throughout the
# codebase to a new project name of your choosing.
#
# Usage: bin/rename-project <new_name>
#
# Accepts any form:
#   bin/rename-project my_project
#   bin/rename-project my-project
#   bin/rename-project "My Project"
#
# The script derives all naming variants from your input:
#   snake_case:  my_project        (Python package, directories)
#   kebab-case:  my-project        (repo name, worktree registry)
#   Title Case:  My Project        (display name, branding)
#   UPPER_SNAKE: MY_PROJECT        (environment variables)
# =============================================================================
set -euo pipefail

# ---------------------------------------------------------------------------
# Color helpers
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info()  { echo -e "${BLUE}[info]${NC}  $1"; }
ok()    { echo -e "${GREEN}[ok]${NC}    $1"; }
warn()  { echo -e "${YELLOW}[warn]${NC}  $1"; }
error() { echo -e "${RED}[error]${NC} $1" >&2; }

# ---------------------------------------------------------------------------
# Navigate to project root
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT"

# ---------------------------------------------------------------------------
# Validate input
# ---------------------------------------------------------------------------
if [ $# -ne 1 ]; then
    error "Usage: bin/rename-project <new_name>"
    echo ""
    echo "  Examples:"
    echo "    bin/rename-project my_project"
    echo "    bin/rename-project my-project"
    echo '    bin/rename-project "My Project"'
    exit 1
fi

RAW_INPUT="$1"

# Reject empty input
if [ -z "$RAW_INPUT" ]; then
    error "Project name cannot be empty."
    exit 1
fi

# Reject invalid characters
if ! echo "$RAW_INPUT" | grep -qE '^[a-zA-Z][a-zA-Z0-9 _-]*$'; then
    error "Project name must start with a letter and contain only letters, numbers, spaces, hyphens, or underscores."
    exit 1
fi

# ---------------------------------------------------------------------------
# Derive all naming forms from input
# ---------------------------------------------------------------------------

# Normalize to snake_case (canonical form)
SNAKE=$(echo "$RAW_INPUT" | tr '[:upper:]' '[:lower:]' | tr ' -' '__' | sed 's/__*/_/g')

# Derive kebab-case
KEBAB=$(echo "$SNAKE" | tr '_' '-')

# Derive UPPER_SNAKE
UPPER_SNAKE=$(echo "$SNAKE" | tr '[:lower:]' '[:upper:]')

# Derive Title Case
TITLE=$(echo "$SNAKE" | tr '_' ' ' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1')

# Reject no-op
if [ "$SNAKE" = "platform_django" ]; then
    error "New name is the same as current name. Nothing to do."
    exit 1
fi

# ---------------------------------------------------------------------------
# Confirm with user
# ---------------------------------------------------------------------------
echo ""
echo "============================================"
echo "  Project Rename"
echo "============================================"
echo ""
echo "  Current name:  platform_django"
echo "  New name:      $SNAKE"
echo ""
echo "  Naming variants:"
echo "    snake_case:   $SNAKE"
echo "    kebab-case:   $KEBAB"
echo "    Title Case:   $TITLE"
echo "    UPPER_SNAKE:  $UPPER_SNAKE"
echo ""

# Check git status
if command -v git &>/dev/null && git rev-parse --git-dir &>/dev/null; then
    if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
        warn "You have uncommitted changes. Consider committing first so you can revert if needed."
        echo ""
    fi
fi

read -rp "Proceed with rename? [y/N] " CONFIRM
if [[ ! "$CONFIRM" =~ ^[yY]$ ]]; then
    echo "Aborted."
    exit 0
fi

echo ""

# ---------------------------------------------------------------------------
# Helper: portable sed -i (macOS vs Linux)
# ---------------------------------------------------------------------------
if sed --version 2>/dev/null | grep -q GNU; then
    SED_INPLACE=(sed -i)
else
    # macOS BSD sed
    SED_INPLACE=(sed -i '')
fi

# ---------------------------------------------------------------------------
# Helper: replace pattern in all text files
# ---------------------------------------------------------------------------
replace_in_files() {
    local pattern="$1"
    local replacement="$2"

    # Use grep to find files containing the pattern, skipping binary files (-I)
    # and excluding directories/files we don't want to touch.
    local files
    files=$(grep -rlI "$pattern" . \
        --exclude-dir=.git \
        --exclude-dir=node_modules \
        --exclude-dir=__pycache__ \
        --exclude-dir=dist \
        --exclude-dir=_build \
        --exclude-dir=.mypy_cache \
        --exclude-dir=.ruff_cache \
        --exclude='*.pyc' \
        --exclude='*.mo' \
        --exclude='uv.lock' \
        --exclude='rename-project' \
        2>/dev/null) || true

    if [ -n "$files" ]; then
        echo "$files" | while IFS= read -r file; do
            "${SED_INPLACE[@]}" "s|${pattern}|${replacement}|g" "$file"
        done
    fi
}

# ---------------------------------------------------------------------------
# Step 1: Rename directories (deepest first)
# ---------------------------------------------------------------------------
info "Renaming directories..."

# apps/platform_django/ → apps/{SNAKE}/
if [ -d "apps/platform_django" ]; then
    mv "apps/platform_django" "apps/$SNAKE"
    ok "apps/platform_django/ → apps/$SNAKE/"
fi

# platform_django/ → {SNAKE}/ (the main Python package)
if [ -d "platform_django" ]; then
    mv "platform_django" "$SNAKE"
    ok "platform_django/ → $SNAKE/"
fi

# ---------------------------------------------------------------------------
# Step 2: Rename files
# ---------------------------------------------------------------------------
info "Renaming files..."

# Template file: {SNAKE}/templates/apps/platform_django.html
OLD_TEMPLATE="$SNAKE/templates/apps/platform_django.html"
NEW_TEMPLATE="$SNAKE/templates/apps/$SNAKE.html"
if [ -f "$OLD_TEMPLATE" ]; then
    mv "$OLD_TEMPLATE" "$NEW_TEMPLATE"
    ok "$OLD_TEMPLATE → $NEW_TEMPLATE"
fi

# ---------------------------------------------------------------------------
# Step 3: Find-and-replace in file contents
# ---------------------------------------------------------------------------
info "Replacing file contents..."

# Order matters: longest/most-specific first to avoid partial replacements

# Pass 1: "Platform Django" → Title Case (longest match first)
info "  Pass 1/4: Platform Django → $TITLE"
replace_in_files "Platform Django" "$TITLE"

# Pass 2: PLATFORM_DJANGO → UPPER_SNAKE (before snake to avoid partial match)
info "  Pass 2/4: PLATFORM_DJANGO → $UPPER_SNAKE"
replace_in_files "PLATFORM_DJANGO" "$UPPER_SNAKE"

# Pass 3: platform_django → snake_case
info "  Pass 3/4: platform_django → $SNAKE"
replace_in_files "platform_django" "$SNAKE"

# Pass 4: platform-django → kebab-case
info "  Pass 4/4: platform-django → $KEBAB"
replace_in_files "platform-django" "$KEBAB"

ok "All replacements complete."

# ---------------------------------------------------------------------------
# Step 4: Clean up build artifacts with stale references
# ---------------------------------------------------------------------------
info "Cleaning build artifacts..."

rm -rf .mypy_cache docs/_build .ruff_cache
ok "Removed .mypy_cache/, docs/_build/, .ruff_cache/"

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
echo ""
echo -e "${GREEN}============================================${NC}"
echo -e "${GREEN}  Rename complete: platform_django → $SNAKE${NC}"
echo -e "${GREEN}============================================${NC}"
echo ""
echo "  Next steps:"
echo "    1. uv sync"
echo "    2. pnpm install"
echo "    3. just up"
echo "    4. just manage migrate"
echo "    5. cd apps/$SNAKE && pnpm openapi-ts"
echo ""
